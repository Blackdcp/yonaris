{
  "name": "yonaris",
  "version": "0.2.13",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "biome format --write --config-path=biome.json .",
    "format-and-lint": "biome check --config-path=biome.json .",
    "format-and-lint:fix": "biome check --write --config-path=biome.json .",
    "knip": "knip",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "test:e2e": "pnpm --filter e2e test:e2e",
    "test:e2e-local": "bash e2e/run-local.sh",
    "test:api": "pnpm --filter e2e test:api",
    "license-check": "node scripts/check-licenses.mjs",
    "audit:public-output": "node scripts/public-output-audit.mjs",
    "test:public-output-policy": "node --test scripts/public-output-policy.test.mjs scripts/e2e-compose-topology.test.mjs scripts/e2e-language-smoke-contract.test.mjs",
    "verify:public-output-release": "node scripts/verify-public-output-release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@changesets/cli": "^2.31.1",
    "ajv": "^8.20.0",
    "knip": "^6.27.0",
    "tsx": "^4.23.1",
    "turbo": "^2.10.5",
    "typescript": "^7.0.2"
  }
}
