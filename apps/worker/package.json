{
	"name": "@workspace/worker",
	"version": "0.2.17",
	"private": true,
	"license": "MIT",
	"scripts": {
		"dev": "tsx --env-file=../web/.env src/index.ts",
		"start": "tsx src/index.ts",
		"account:customer": "tsx src/manage-customer-account.ts",
		"provision:client-viewer": "tsx src/manage-customer-account.ts --organization-role viewer",
		"repair:local-admin": "tsx src/repair-local-admin.ts",
		"run:database-report": "tsx src/run-database-report.ts",
		"run:sampling-batch": "tsx src/run-sampling-batch.ts",
		"import:reviewed-consumer-cohort": "tsx src/import-reviewed-consumer-cohort.ts",
		"test": "tsx --test src/local-admin-repair.test.ts src/database-report-request.test.ts src/customer-account-ops.test.ts src/local-demo-import-policy.test.ts src/local-demo-atomic-import-policy.test.ts src/reviewed-consumer-cohort-policy.test.ts src/reviewed-consumer-cohort-import-policy.test.ts src/sampling-batch-request.test.ts src/sampling-batch-operation.test.ts src/jobs/schedule-maintenance-policy.test.ts",
		"build": "tsc -p tsconfig.json",
		"check-types": "tsc --noEmit"
	},
	"dependencies": {
		"@sentry/node": "^10.66.0",
		"@workspace/deployment": "workspace:*",
		"@workspace/lib": "workspace:*",
		"@workspace/whitelabel": "workspace:*",
		"auth0": "^6.0.0",
		"drizzle-orm": "^0.45.2",
		"pg": "^8.22.0",
		"pg-boss": "^12.26.1",
		"posthog-node": "^5.45.2"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"@types/pg": "^8.20.0",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2"
	}
}
