{
	"version": "kimi-web-20260821-localpc-v2",
	"surface": "kimi.consumer_web",
	"launchUrl": "https://www.kimi.com/",
	"conversationPathPattern": "^/(?:chat/[A-Za-z0-9_-]{4,200})?/?$",
	"allowedSearchPattern": "^\\?chat_enter_method=new_chat$",
	"composer": "div.chat-input-editor[contenteditable=\"true\"][role=\"textbox\"]",
	"send": ".send-button-container",
	"newConversation": ".action-label",
	"newConversationLabel": "新建会话",
	"userMessage": "[data-message-role=\"user\"],[class*=\"user-message\"],.chat-content-item-user",
	"answer": "[data-message-role=\"assistant\"],[class*=\"assistant-message\"],.segment-content",
	"generating": "button[aria-label*=\"停止\"],[class*=\"stop-button\"],[data-testid*=\"stop\"]",
	"completion": null,
	"completionCompanion": null,
	"loginWall": ".login-dialog,.login-modal,.next-sidebar-history-list__login,input[type=\"tel\"],input[type=\"password\"]",
	"captcha": "iframe[src*=\"captcha\"],[class*=\"captcha\"]",
	"rateLimit": "[class*=\"rate-limit\"],[class*=\"rate_limit\"]",
	"accountRestricted": "body",
	"accountRestrictedTextPattern": "账号(?:已被)?(?:限制|禁言|封禁)|account (?:has been )?(?:restricted|suspended|banned)",
	"searchUsed": null,
	"searchNotUsed": null,
	"citationLink": "a[href^=\"http\"]",
	"queryItem": null,
	"searchEvidence": null
}
