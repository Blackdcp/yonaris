{
	"version": "kimi-web-20260823-localpc-v16",
	"surface": "kimi.consumer_web",
	"launchUrl": "https://www.kimi.com/",
	"conversationPathPattern": "^/chat/[A-Za-z0-9_-]{4,200}/?$",
	"allowedSearchPattern": "^\\?chat_enter_method=(?:new_chat|home|shortcut)$",
	"composer": "div.chat-input-editor[contenteditable=\"true\"][role=\"textbox\"]",
	"send": ".send-button-container:not(.disabled)",
	"newConversation": "a[href=\"/\"]:has(svg[name=\"AddConversation\"])",
	"newConversationLabel": null,
	"userMessage": ".chat-content-item-user .user-content",
	"answer": ".chat-content-item-assistant .segment-content-box",
	"generating": "button[aria-label*=\"停止\"],[class*=\"stop-button\"],[data-testid*=\"stop\"],.chat-content-item-assistant .segment-content-box:has(.toolcall-container.toolcall-web_search):not(:has(> .markdown-container))",
	"completion": null,
	"completionCompanion": null,
	"loginWall": ".login-dialog,.login-modal,.next-sidebar-history-list__login,input[type=\"tel\"],input[type=\"password\"]",
	"captcha": "iframe[src*=\"captcha\"],[class*=\"captcha\"]",
	"rateLimit": "[role=\"dialog\"],[aria-modal=\"true\"],[class*=\"modal\"],[class*=\"dialog\"]",
	"rateLimitTextPattern": "和Kimi聊天的人太多|订阅会员可进入独立的优先队列",
	"accountRestricted": "body",
	"accountRestrictedTextPattern": "账号(?:已被)?(?:限制|禁言|封禁)|account (?:has been )?(?:restricted|suspended|banned)",
	"searchUsed": null,
	"searchNotUsed": null,
	"citationLink": "a[href^=\"http\"]",
	"queryItem": null,
	"searchEvidence": null
}
