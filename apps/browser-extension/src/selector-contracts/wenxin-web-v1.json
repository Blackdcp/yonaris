{
	"version": "wenxin-web-20260822-localpc-v8",
	"surface": "wenxin.consumer_web",
	"launchUrl": "https://wenxin.baidu.com/",
	"conversationPathPattern": "^/search/[0-9]{4,30}/?$",
	"conversationSearchPattern": "^\\?enter_type=chat_url$",
	"composer": "textarea#chat-textarea.ci-textarea[data-ai-placeholder]",
	"send": "#ci-submit-button-ai.ci-submit-button-ai-active",
	"newConversation": ".new-dialog-container-button",
	"newConversationLabel": "开启新对话",
	"userMessage": ".conversation-flow-question-container .cs-question-pure-text",
	"answer": ".conversation-flow-answer-container .ai-entry",
	"generating": "button[aria-label*=\"停止\"],[class*=\"stop-response\"],[data-testid*=\"stop\"]",
	"completion": null,
	"completionCompanion": null,
	"loginWall": "[class*=\"login-dialog\"],[class*=\"login-modal\"],[class*=\"login-btn\"],input[type=\"tel\"],input[type=\"password\"]",
	"captcha": "iframe[src*=\"captcha\"],[class*=\"captcha\"]",
	"rateLimit": "[class*=\"rate-limit\"],[class*=\"rate_limit\"]",
	"accountRestricted": "body",
	"accountRestrictedTextPattern": "账号(?:已被)?(?:限制|禁言|封禁)|account (?:has been )?(?:restricted|suspended|banned)",
	"searchUsed": null,
	"searchNotUsed": null,
	"citationLink": "a[href^=\"http\"]",
	"queryItem": null,
	"searchEvidence": null
}
