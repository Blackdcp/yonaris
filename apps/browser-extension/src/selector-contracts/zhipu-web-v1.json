{
	"version": "zhipu-web-20260821-localpc-v1",
	"surface": "zhipu.consumer_web",
	"launchUrl": "https://chatglm.cn/",
	"conversationPathPattern": "^/main/alltoolsdetail/?$",
	"conversationSearchPattern": "^\\?lang=zh&cid=[a-f0-9]{24}$",
	"composer": "#search-input-box textarea.scroll-display-none",
	"send": "#search-input-box .enter:not(.searching)",
	"newConversation": ".new-session",
	"newConversationLabel": "新对话",
	"userMessage": "[id^=\"row-question-p-\"].question-txt",
	"answer": "[id^=\"row-answer-\"].answer .answer-content-wrap .markdown-body",
	"generating": "#search-input-box .enter.searching",
	"completion": null,
	"completionCompanion": null,
	"loginWall": ".sidebar-avatar.guest-avatar",
	"captcha": "iframe[src*=\"captcha\"],[class*=\"captcha\"]",
	"rateLimit": "[class*=\"rate-limit\"],[class*=\"rate_limit\"]",
	"accountRestricted": "body",
	"accountRestrictedTextPattern": "账号(?:已被)?(?:限制|禁言|封禁)|account (?:has been )?(?:restricted|suspended|banned)",
	"searchUsed": null,
	"searchNotUsed": null,
	"citationLink": "a[href^=\"http\"]",
	"queryItem": null,
	"searchEvidence": null
}
