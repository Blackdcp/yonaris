{
	"version": "yuanbao-web-20260821-localpc-v1",
	"surface": "yuanbao.consumer_web",
	"launchUrl": "https://yuanbao.tencent.com/",
	"conversationPathPattern": "^/chat/[A-Za-z0-9_-]{4,200}/?$",
	"composer": ".ql-editor[contenteditable=\"true\"]",
	"send": "#yuanbao-send-btn[aria-label=\"发送\"]",
	"newConversation": "[data-testid*=\"new-chat\"],[class*=\"new-chat\"],[class*=\"new-dialog\"],button,[role=\"button\"]",
	"newConversationLabel": "新建对话",
	"userMessage": "[data-message-role=\"user\"],[class*=\"user-message\"],[class*=\"human-message\"]",
	"answer": "[data-message-role=\"assistant\"],[class*=\"assistant-message\"],[class*=\"agent-message\"]",
	"generating": "button[aria-label*=\"停止\"],[class*=\"stop-response\"],[data-testid*=\"stop\"]",
	"completion": null,
	"completionCompanion": null,
	"loginWall": ".agent-dialogue__tool__login,.hyc-login,input[type=\"tel\"],input[type=\"password\"]",
	"captcha": "iframe[src*=\"captcha\"],[class*=\"captcha\"]",
	"rateLimit": "[class*=\"rate-limit\"],[class*=\"rate_limit\"]",
	"accountRestricted": "body",
	"accountRestrictedTextPattern": "账号(?:已被)?(?:限制|禁言|封禁)|account (?:has been )?(?:restricted|suspended|banned)",
	"searchUsed": null,
	"searchNotUsed": null,
	"citationLink": "a[href^=\"http\"]",
	"queryItem": null,
	"searchEvidence": null
}
