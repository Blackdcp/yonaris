{
	"version": "yuanbao-web-20260822-localpc-v10",
	"surface": "yuanbao.consumer_web",
	"launchUrl": "https://yuanbao.tencent.com/",
	"conversationPathPattern": "^/chat/[A-Za-z0-9_-]{4,200}/[A-Za-z0-9_-]{4,200}/?$",
	"composer": ".ql-editor[contenteditable=\"true\"]",
	"send": "#yuanbao-send-btn[aria-label=\"发送\"]:not([class*=\"disabled\"])",
	"newConversation": "[data-desc=\"new-chat\"]",
	"newConversationLabel": null,
	"userMessage": ".agent-chat__bubble--human .hyc-content-text",
	"answer": ".agent-chat__bubble--ai .agent-chat__speech-card__text",
	"generating": ".hyc-content-md:not(.hyc-content-md-done)",
	"completion": null,
	"completionCompanion": null,
	"loginWall": ".agent-dialogue__tool__login,.hyc-login,input[type=\"tel\"],input[type=\"password\"]",
	"captcha": "iframe[src*=\"captcha\"],[class*=\"captcha\"]",
	"rateLimit": "[class*=\"rate-limit\"],[class*=\"rate_limit\"]",
	"accountRestricted": "body",
	"accountRestrictedTextPattern": "账号(?:已被)?(?:限制|禁言|封禁)|account (?:has been )?(?:restricted|suspended|banned)",
	"searchUsed": null,
	"searchNotUsed": null,
	"citationLink": "a[href^=\"http\"]",
	"queryItem": null,
	"searchEvidence": null
}
