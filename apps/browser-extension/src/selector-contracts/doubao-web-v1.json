{
	"version": "doubao-web-20260818-localpc-v6",
	"surface": "doubao.consumer_web",
	"launchUrl": "https://www.doubao.com/chat/",
	"conversationPathPattern": "^/chat/(?:[0-9]+|local_[0-9]+)$",
	"composer": "div.tiptap.ProseMirror[contenteditable=\"true\"][role=\"textbox\"]",
	"send": "#flow-end-msg-send",
	"newConversation": "#flow_chat_sidebar .nav-link-IkIer0",
	"newConversationLabel": "新对话",
	"userMessage": "div.content-KTJ1Rj",
	"answer": "div[data-message-id].relative.grid.w-full",
	"generating": "#input-engine-container button.bg-dbx-text-highlight",
	"loginWall": "input[type=\"password\"],input[type=\"tel\"]",
	"captcha": "iframe[src*=\"captcha\"],[class*=\"captcha\"],[class*=\"verify\"]",
	"rateLimit": "[class*=\"rate-limit\"],[class*=\"rate_limit\"],[data-testid=\"rate-limit\"]",
	"accountRestricted": "body",
	"accountRestrictedTextPattern": "账号已被禁言|账号已被封禁|账号存在异常|account (?:has been )?(?:restricted|suspended|banned)",
	"searchUsed": null,
	"searchNotUsed": null,
	"citationLink": "a[href^=\"http\"]",
	"queryItem": null
}
