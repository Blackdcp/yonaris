{
	"version": "qwen-web-20260822-localpc-v11",
	"surface": "qwen.consumer_web",
	"launchUrl": "https://www.qianwen.com/",
	"conversationPathPattern": "^/(?:chat/[A-Za-z0-9_-]{4,200})?/?$",
	"composer": "div[contenteditable=\"true\"][role=\"textbox\"][data-slate-editor=\"true\"]",
	"send": "button[aria-label=\"发送消息\"]:not([disabled])",
	"newConversation": "button",
	"newConversationLabel": "新建对话",
	"userMessage": ".question-text-card",
	"answer": ".chat-answers-card-wrap .answer-common-card",
	"generating": "button[aria-label=\"停止回答\"]:not([disabled])",
	"completion": null,
	"completionCompanion": null,
	"loginWall": "[data-testid*=\"login-dialog\"],[class*=\"login-dialog\"],input[type=\"tel\"],input[type=\"password\"]",
	"captcha": "iframe[src*=\"captcha\"],[class*=\"captcha\"]",
	"rateLimit": "[class*=\"rate-limit\"],[class*=\"rate_limit\"]",
	"accountRestricted": "body",
	"accountRestrictedTextPattern": "账号(?:已被)?(?:限制|禁言|封禁)|account (?:has been )?(?:restricted|suspended|banned)",
	"searchUsed": null,
	"searchNotUsed": null,
	"citationLink": "a[href^=\"http\"]",
	"queryItem": null,
	"searchEvidence": null
}
