[Unit]
Description=Yonaris exact-host browser egress proxy
Documentation=file:/etc/yonaris-browser-runner/README.md
After=network-online.target
Wants=network-online.target
PartOf=yonaris-browser-network.service

[Service]
Type=simple
User=yonaris-browser-proxy
Group=yonaris-browser-proxy
UMask=0027
EnvironmentFile=/etc/yonaris-browser-runner/network.env
Environment=PATH=@@NODE_BIN_DIRECTORY@@:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=@@SOURCE_DIRECTORY@@
ExecStart=@@NODE_EXECUTABLE@@ @@TSX_EXECUTABLE@@ @@SOURCE_DIRECTORY@@/apps/browser-runner/src/egress-proxy-cli.ts
Restart=no
TimeoutStartSec=30
TimeoutStopSec=15
KillMode=mixed
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=127.0.0.0/8
IPAddressAllow=::1/128
IPAddressDeny=localhost
IPAddressDeny=link-local
IPAddressDeny=multicast
IPAddressDeny=10.0.0.0/8
IPAddressDeny=100.64.0.0/10
IPAddressDeny=172.16.0.0/12
IPAddressDeny=192.168.0.0/16
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
TasksMax=128
LimitNOFILE=4096
MemoryMax=256M
