[Unit]
Description=Yonaris browser-identity egress policy
Documentation=file:/etc/yonaris-browser-runner/README.md
Requires=yonaris-browser-egress-proxy.service
After=network-online.target ufw.service yonaris-browser-egress-proxy.service
Wants=network-online.target
Before=yonaris-browser-broker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/yonaris-browser-runner/network.env
RuntimeDirectory=yonaris-browser-runner
RuntimeDirectoryMode=0755
ExecStart=/usr/local/sbin/yonaris-apply-browser-egress
ExecStartPost=/usr/local/sbin/yonaris-browser-egress-negative-probes
ExecStop=/usr/local/sbin/yonaris-clear-browser-egress
ExecStopPost=/usr/local/sbin/yonaris-clear-browser-egress
RemainAfterExit=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
@@KERNEL_MODULE_PROTECTION@@
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
