#!/usr/bin/python3

import os
import socket
import struct
import sys


def main() -> int:
    if len(sys.argv) != 1 or sys.platform != "linux":
        return 64
    try:
        inherited = socket.socket(fileno=3)
        size = struct.calcsize("3i")
        raw = inherited.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, size)
        pid, uid, gid = struct.unpack("3i", raw)
    except (OSError, ValueError, struct.error):
        return 70
    if min(pid, uid, gid) < 0:
        return 70
    os.write(1, f"{pid} {uid} {gid}\n".encode("ascii"))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
