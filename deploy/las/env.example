# Production template only; it is not a deployable dotenv until every required
# placeholder/provider credential is replaced and the root-owned migration
# readiness producer exists. Do not fabricate migration evidence or deploy from
# this example. The stable runtime parser treats this as UTF-8 data, not shell:
# duplicate/unknown keys, NUL, expansion syntax, malformed quoting, and unsafe
# unquoted whitespace/metacharacters are rejected before Docker access.

# Compose release settings
# The stable runtime manager overrides this with the same canonical path before
# rendering Compose. Keeping the value exact also prevents ad-hoc/manual runs
# from reading a deploy-user-owned file.
APP_ENV_FILE=/etc/yonaris/las-runtime.env
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=blackdcp
IMAGE_TAG=sha-0000000000000000000000000000000000000000
WEB_PORT=1515
WORKER_ENABLED=true
WORKER_QUEUE_SCOPE=full

# PostgreSQL. Generate a URL-safe password with: openssl rand -hex 24
POSTGRES_USER=yonaris
POSTGRES_PASSWORD=replace_with_a_random_hex_password
POSTGRES_DB=yonaris
DATABASE_URL=postgresql://yonaris:replace_with_the_same_random_hex_password@postgres:5432/yonaris

# Yonaris runtime
DEPLOYMENT_MODE=local
VITE_DEPLOYMENT_MODE=local
DEPLOYMENT_ID=replace_with_a_uuid
ENVIRONMENT=production
APP_URL=https://portal.yonaris.com
VITE_APP_URL=https://portal.yonaris.com
VITE_SITE_URL=https://yonaris.com
APP_NAME=Yonaris
APP_ICON=/icons/yonaris-icon.svg
APP_WORDMARK=/brand/yonaris-wordmark-navy.png
APP_WORDMARK_ON_DARK=/brand/yonaris-wordmark-white.png
VITE_APP_NAME=Yonaris
VITE_APP_ICON=/icons/yonaris-icon.svg
VITE_APP_WORDMARK=/brand/yonaris-wordmark-navy.png
VITE_APP_WORDMARK_ON_DARK=/brand/yonaris-wordmark-white.png
DISABLE_TELEMETRY=1
DEFAULT_DELAY_HOURS=24
RUNS_PER_PROMPT=5
# Keep Chinese artifact writes disabled before the irreversible root-owned
# activation marker. Once that marker exists, this value and WORKER_ENABLED
# must both be the exact lowercase value true; every other combination fails
# before Docker access. Never create the marker or edit this flag by hand to
# bypass the activation runbook.
ARTIFACT_ZH_CN_ENABLED=false
# The former browser-runner-activation forced operation is permanently
# disabled. Keep this false on LAS. Any future browser capability needs a new
# reviewed stable operation/protocol; runner credentials and DOM selectors
# belong on the separate CN runner host, not here or in customer accounts.
BROWSER_RUNNER_ENABLED=false
# The former response-snapshot-activation forced operation is permanently
# disabled and no replacement stable operation exists. Keep this exact value
# false; do not run the candidate helper, expose the runtime dotenv/socket, or
# add the retired operation to a root policy.
RESPONSE_SNAPSHOT_ENABLED=false
RESPONSE_SNAPSHOT_HOST_ROOT=/var/lib/yonaris/response-snapshots/v1
RESPONSE_SNAPSHOT_ROOT=/var/lib/yonaris/response-snapshots/v1
RESPONSE_SNAPSHOT_RETENTION_DAYS=90
RESPONSE_SNAPSHOT_WARN_USED_PERCENT=70
RESPONSE_SNAPSHOT_STOP_USED_PERCENT=80
RESPONSE_SNAPSHOT_OUTBOX_TTL_HOURS=24
# Optional comma-separated legacy:canonical route aliases for brand ID migrations.
BRAND_ID_ALIASES=

# Generate a new production auth secret with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace_with_a_new_production_auth_secret

# For the initial data migration, copy the exact CREDENTIAL_ENCRYPTION_KEY from the
# current local environment. It must decode to exactly 32 bytes.
CREDENTIAL_ENCRYPTION_KEY=replace_with_the_existing_base64_encryption_key

# Direct model providers. Start with the currently used DeepSeek and Agnes
# credentials; leave unused providers empty.
DEEPSEEK_API_KEY=
AGNES_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# The current memory-tensor test uses this target. Keep it for the first
# migration so production behavior matches the local dataset.
SCRAPE_TARGETS=chatgpt:brightdata:online
BRIGHTDATA_API_TOKEN=
# Required whenever BRIGHTDATA_API_TOKEN is configured for an LAS deployment.
# The administrator Overseas Run now control defaults to all six Bright Data
# channels; use the exact name of an active, account-owned SERP zone.
BRIGHTDATA_SERP_ZONE=
OLOSTEP_API_KEY=
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Optional integrations
JINA_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Portal transactional email. Use a yonaris.com domain-scoped Sending Access
# key only after the sender domain has been verified in Resend. These values
# are consumed by Portal account and notification flows; they do not authorize
# a separate public-site runtime or delivery capability.
RESEND_API_KEY=
RESEND_FROM_EMAIL='Yonaris <notifications@yonaris.com>'
SENTRY_DSN=
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
