yonaris.com, www.yonaris.com {
	tls /etc/caddy/certs/yonaris/yonaris-origin.pem /etc/caddy/certs/yonaris/yonaris-origin.key
	encode zstd gzip
	route {
		@public path / /zh /zh/* /platform /platform/* /methodology /methodology/* /results /results/* /geo /geo/* /diagnostic /diagnostic/* /agent /agent/* /llms.txt /llms-full.txt /assets/* /brand/* /icons/* /apple-touch-icon.png /favicon.ico /site.webmanifest /og.png /robots.txt /sitemap.xml /api/plausible/*
		reverse_proxy @public 127.0.0.1:1516
		respond 404
	}
}
