[Unit]
Description=Back up the Yonaris PostgreSQL database
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=yonaris-deploy
Group=yonaris-deploy
SupplementaryGroups=docker
UMask=0077
Environment=DEPLOY_ROOT=/opt/yonaris
Environment=COMPOSE_FILE=/opt/yonaris/source/deploy/las/compose.yaml
Environment=ENV_FILE=/opt/yonaris/.env
ExecStart=/usr/bin/bash /opt/yonaris/source/deploy/las/bin/backup.sh

