meta {
  name: update prompt
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/api/v1/prompts/{{createdPromptId}}
  body: json
  auth: inherit
}

body:json {
  {
    "tags": ["updated"]
  }
}

assert {
  res.status: eq 200
  res.body.id: eq {{createdPromptId}}
  res.body.value: contains best testing framework
  res.body.tags: contains updated
}
