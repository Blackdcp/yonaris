meta {
  name: get report
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/reports/{{createdReportId}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.reportId: eq {{createdReportId}}
  res.body.status: eq pending
  res.body.brandName: eq Bruno Omitted Language Report
  res.body.outputLanguage: eq en
}
