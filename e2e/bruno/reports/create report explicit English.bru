meta {
  name: create report with explicit English output
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/reports
  body: json
  auth: inherit
}

body:json {
  {
    "brandName": "Bruno Explicit English Report",
    "brandWebsite": "https://example.com",
    "outputLanguage": "en"
  }
}

assert {
  res.status: eq 201
  res.body.status: eq pending
  res.body.reportId: isDefined
  res.body.outputLanguage: eq en
}

script:post-response {
  bru.setVar("createdEnglishReportId", res.getBody().reportId);
}
