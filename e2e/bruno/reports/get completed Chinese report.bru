meta {
  name: get completed Simplified Chinese report
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/v1/reports/{{chineseLanguageReportId}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.status: eq completed
  res.body.outputLanguage: eq zh-CN
  res.body.prompts: isArray
  res.body.prompts[0].promptValue: eq 原始 Prompt / Raw Prompt 01
  res.body.prompts[0].mentions.mentionsTopK[0].entity: eq 原始竞品 / Raw Rival
  res.body.unstable.sov: isNumber
  res.body.unstable.visibility: isNumber
  res.body.unstable.competitors: isArray
  res.body.prompts[0].mentions.brandMentionsTotal: isNumber
}
