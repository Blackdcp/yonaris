{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["policyVersion", "normalizationVersion", "ownerRole", "surfaceClasses", "fingerprints"],
  "properties": {
    "policyVersion": { "const": 1 },
    "normalizationVersion": { "const": 1 },
    "ownerRole": { "const": "release-owner" },
    "surfaceClasses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": { "const": "portal" }
    },
    "fingerprints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sha256", "compactSha256", "characters", "tokens", "severity"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9_]+$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "compactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "characters": { "type": "integer", "minimum": 1, "maximum": 256 },
          "tokens": { "type": "integer", "minimum": 1, "maximum": 16 },
          "severity": { "const": "block" }
        }
      }
    }
  }
}
