{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 1,
  "maxItems": 256,
  "uniqueItems": true,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "minProperties": 6,
    "required": ["fingerprintId", "legalBasisReference", "approvedByRole", "approvedAt", "expiresAt"],
    "properties": {
      "fingerprintId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9_]+$" },
      "exactPathSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "artifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "legalBasisReference": { "type": "string", "minLength": 1, "maxLength": 512 },
      "approvedByRole": { "const": "release-owner" },
      "approvedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$" },
      "expiresAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$" }
    }
  }
}
