{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["surfaceClass", "phases", "runtimeRouteClasses"],
  "properties": {
    "surfaceClass": { "const": "portal" },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "artifact", "image-root"],
      "properties": {
        "source": { "$ref": "#/$defs/phase" },
        "artifact": { "$ref": "#/$defs/phase" },
        "image-root": { "$ref": "#/$defs/phase" }
      }
    },
    "runtimeRouteClasses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["public", "auth"] }
    }
  },
  "$defs": {
    "safePrefix": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?:\\.|(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+)$"
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "allowedRoots", "include", "exclude", "binaryStrategy"],
      "properties": {
        "surface": { "type": "string", "minLength": 1, "maxLength": 128 },
        "allowedRoots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safePrefix" }
        },
        "include": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safePrefix" }
        },
        "exclude": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safePrefix" }
        },
        "binaryStrategy": { "enum": ["strings", "reject"] }
      }
    }
  }
}
